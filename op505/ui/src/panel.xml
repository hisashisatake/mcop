<layout fn="draw_op505_panel" params-type="Op505PanelParams" scroll-id="op505_panel">

  <style>
    <!-- 横並び<panels>グループ内、パネル間の隙間。 -->
    <panels gap="2"/>
    <!-- パネル枠の内側/外側余白（全パネル共通、egui::Marginがi8ベースのため整数のみ）。
         outer-marginは上下2・左右1（CSSショートハンド）。横の隙間＝panels gap(2)+左右マージン(1+1)=4px、
         縦の隙間＝上下マージン(2+2)=4pxで一致する（縦にはgap相当の値が無く、マージンだけで
         隙間ができるため、gap側を2に下げて帳尻を合わせてある）。 -->
    <panel inner-margin="4" outer-margin="2 1"/>
    <!-- 全ウィジェット共通の既定マージン。 -->
    <widget margin="4"/>
    <algorithm-diagram width="130" height="100"/>
    <!-- TimeEg固定枠（Step 2）。GRAPH/KNOBSタブ切替・段数1〜10変更でこのサイズ自体は変わらない。
         高さ245＝ヘッダ20+コンテンツ190+spin行35。コンテンツ190はKNOBSモードの1段カラム
         （ラベル+knob(66px)×2+checkbox、item_spacing込みで実測約175px）が収まる下限
         （Step6実機確認で175だと段カラムがはみ出しパネル高さが跳ねる不具合を発見し追い込んだ値）。 -->
    <time-eg-editor width="260" height="245"/>
  </style>

  <panels match-height="true">
    <panel title="MASTER VOLUME" span="30%">
      <header>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <level-meter label="LEVEL" handle="master_meter"/>
        <knob label="VOLUME" handle="master_volume"/>
      </row>
    </panel>
    <panel title="MASTER EFFECT" span="70%">
      <header>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <enum label="REV TYPE" handle="reverb_type" names="REVERB_TYPE_NAMES" salt="4"/>
        <knob label="REV" handle="rev_send"/>
        <!-- R.TIMEはRoom1〜Plateでは残響時間、Delay/Panning DelayではD.SYNC=OFF時のみ
             ディレイ長+フィードバックの両方、D.SYNC=ON時はフィードバックのみを制御する
             （ディレイ長はD.SYNC/D.RATE×テンポが決める。詳細はspec-sound.md参照）。
             D.SYNC/D.RATEはDelay/Panning Delay以外のタイプでは無視される。 -->
        <knob label="R.TIME" handle="reverb_time"/>
        <checkbox label="D.SYNC" handle="params.delay_sync.as_bool_handle()"/>
        <sync-rate label="D.RATE" handle="delay_sync_rate" salt="17"/>
      </row>
      <row justify="start" gap="spacing">
        <enum label="CHO TYPE" handle="chorus_type" names="CHORUS_TYPE_NAMES" salt="5"/>
        <knob label="CHO" handle="cho_send"/>
        <knob label="C.RATE" handle="chorus_mod_rate"/>
        <knob label="C.DEP" handle="chorus_mod_depth"/>
        <knob label="C.FB" handle="chorus_feedback"/>
        <knob label="C&gt;R" handle="chorus_send_to_reverb"/>
      </row>
    </panel>
  </panels>

  <panels>
    <panel title="PITCH FG" span="50%">
      <header>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <!-- 最終段level=0固定を免除しSTAGE=1も許す（terminal-level="free"）。OP EGと違いボイス
             解放条件に関与しないため、リリース後にオフセットを残せる／段数を8まで使える。
             STAGE=0は無効化（変調なし、エンジンがtickをスキップする）。 -->
        <time-eg-editor handle="params.pitch_fg.eg" mapping="RawLinear" tl-value="255" min-stages="0" terminal-level="free"/>
        <!-- SYNC/RATE/RANGE/BASE/RETRIG/TEXTURE/P.DEPTHはtime-eg-editorの下に新しい行を
             足すのではなく、右のstackへ縦積みする（OP1〜4パネルと同じ配置規約。
             time-eg-editorは245px固定サイズの自前描画ウィジェットのため、panel直下に
             別rowを足すとレイアウトが伸びずグラフに重なる）。<fg-rate>はSYNC ON/OFFで
             ノブ・下段の表示先そのものを切り替える複合ウィジェット（ON=sync_rate+音価
             ドロップダウン、OFF=free_rate+数値欄、100×70）。RANGE/BASEはSYNC OFF時の
             free_rateが動かせる可変幅・基準周波数（詳細はmemory
             `project_fg_free_rate_texture_templates_design.md`）。 -->
        <stack gap="spacing" center="true">
          <!-- 質感。TRIANGLE〜SQUAREは幾何学的テンプレート波形、S&H以降は旧質感LFOの
               後継（乱数系）。OFF以外は保持区間がテンプレートへ全面置換され、GRAPHの
               手描きSTAGEは参照されなくなる（time_eg_editorが表示専用ビューへ切り替える）。 -->
          <enum label="TEXTURE" handle="params.pitch_fg.eg.texture_handle()" names="TEXTURE_NAMES" salt="13" height="36"/>
          <enum label="RETRIG" handle="params.pitch_fg.eg.retrigger_mode_handle()" names="RETRIGGER_MODE_NAMES" salt="7" height="36"/>
          <checkbox label="SYNC" handle="params.pitch_fg.eg.sync_enabled_handle()"/>
          <knob label="BASE" handle="params.pitch_fg.eg.base_freq_handle()"/>
          <enum label="RANGE" handle="params.pitch_fg.eg.rate_range_handle()" names="RATE_RANGE_NAMES" salt="18" height="36"/>
        </stack>
        <stack gap="spacing" center="true">
          <fg-rate label="RATE" sync="params.pitch_fg.eg.sync_enabled_handle()" sync-rate="params.pitch_fg.eg.sync_rate_handle()" free-rate="params.pitch_fg.eg.free_rate_handle()" rate-range="params.pitch_fg.eg.rate_range_handle()" salt="6"/>
          <!-- Depthは符号を持たない振れ幅の倍率（0＝変調なし）。符号はFGのレベル波形が
               持つため、バイポーラ表示（±）にはしない。 -->
          <knob label="P.DEPTH" handle="params.pitch_fg.depth"/>
        </stack>
      </row>
    </panel>
    <panel title="GAIN FG" span="50%">
      <header>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <!-- Gain FGだけ最終段level=0固定を免除し、STAGE=1も許す。出力への乗算でボイス解放には
             関与しないため0へ向かう必要がなく、level 0が「無音」を意味してしまうため
             （1段=透過既定＝ゲートを一切閉じない、op505-coreのdefault_gain_fg参照）。
             STAGE=0は無効化（Voice::tickがgain_fg_outを1.0固定でスキップする、0.0ではない
             ことに注意——0.0だと無音になる）。 -->
        <stack gap="spacing" center="true">
          <time-eg-editor handle="params.gain_fg.eg" mapping="AmplitudeLinear" tl-value="255" min-stages="0" terminal-level="free"/>
          <!-- 行先スイッチ（旧CHIP LFO AM経路の厳密代替）。MASTER=合成後の一括乗算、
               OP=am_enableな各オペレーターのamp_factorへ乗算（変調指数のうねり）。
               両方ON/両方OFFも可（排他ではない）。TimeEgグラフ下の余白に横並びで置き、
               専用カラムを持たせないことで横幅を節約する。 -->
        </stack>
        <stack gap="spacing" center="true">
          <enum label="TEXTURE" handle="params.gain_fg.eg.texture_handle()" names="TEXTURE_NAMES" salt="14" height="36"/>
          <enum label="RETRIG" handle="params.gain_fg.eg.retrigger_mode_handle()" names="RETRIGGER_MODE_NAMES" salt="11" height="36"/>
          <checkbox label="SYNC" handle="params.gain_fg.eg.sync_enabled_handle()"/>
          <knob label="BASE" handle="params.gain_fg.eg.base_freq_handle()"/>
          <enum label="RANGE" handle="params.gain_fg.eg.rate_range_handle()" names="RATE_RANGE_NAMES" salt="19" height="36"/>
        </stack>
        <stack gap="spacing" center="true">
          <fg-rate label="RATE" sync="params.gain_fg.eg.sync_enabled_handle()" sync-rate="params.gain_fg.eg.sync_rate_handle()" free-rate="params.gain_fg.eg.free_rate_handle()" rate-range="params.gain_fg.eg.rate_range_handle()" salt="10"/>
          <!-- Depthは符号を持たない振れ幅の倍率だが、既定255（EGの形をそのまま使う）である点が
               P.DEPTH/F.DEPTH（既定0＝無変調）と違う。詳細はOp505GainFgのdocコメント参照。 -->
          <knob label="G.DEPTH" handle="params.gain_fg.depth"/>
          <checkbox label="MASTER" handle="gain_fg_to_master"/>
          <checkbox label="OP" handle="gain_fg_to_operators"/>
        </stack>
      </row>
    </panel>
  </panels>

  <panels match-height="true">
    <panel title="CUTOFF FG" span="65%">
      <header>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <!-- STAGE=0は無効化（Pitch FGと同じ、変調なし）。 -->
        <time-eg-editor handle="params.cutoff_fg.eg" mapping="RawLinear" tl-value="255" min-stages="0" terminal-level="free"/>
        <stack gap="spacing" center="true">
          <enum label="TEXTURE" handle="params.cutoff_fg.eg.texture_handle()" names="TEXTURE_NAMES" salt="15" height="36"/>
          <enum label="RETRIG" handle="params.cutoff_fg.eg.retrigger_mode_handle()" names="RETRIGGER_MODE_NAMES" salt="9" height="36"/>
          <checkbox label="SYNC" handle="params.cutoff_fg.eg.sync_enabled_handle()"/>
          <knob label="BASE" handle="params.cutoff_fg.eg.base_freq_handle()"/>
          <enum label="RANGE" handle="params.cutoff_fg.eg.rate_range_handle()" names="RATE_RANGE_NAMES" salt="20" height="36"/>
        </stack>
        <stack gap="spacing" center="true">
          <fg-rate label="RATE" sync="params.cutoff_fg.eg.sync_enabled_handle()" sync-rate="params.cutoff_fg.eg.sync_rate_handle()" free-rate="params.cutoff_fg.eg.free_rate_handle()" rate-range="params.cutoff_fg.eg.rate_range_handle()" salt="8"/>
          <!-- P.DEPTHと同じくバイポーラ表示にしない（符号はレベル波形側）。 -->
          <knob label="F.DEPTH" handle="params.cutoff_fg.depth"/>
        </stack>
        <stack gap="spacing" center="true">
          <!-- FILTER欄（旧・独立パネル）をここへ統合。CUTOFF FGはこのフィルターのカットオフを
               変調するFGなので、フィルター本体のパラメーターと同じstackに置いて対応関係を分かりやすくする。 -->
          <enum label="TYPE" handle="filter_type" names="FILTER_TYPE_NAMES" salt="12" height="36"/>
          <knob label="CUTOFF" handle="cutoff"/>
          <knob label="RESO" handle="resonance"/>
          <checkbox label="SELF-OSC" handle="filter_self_oscillation" width="100"/>
        </stack>
      </row>
    </panel>
    <panel title="CHANNEL" span="35%">
      <header>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <stack gap="spacing" center="true">
          <algorithm-diagram handle="algorithm"/>
          <row justify="start" gap="spacing">
            <!-- 固定音階（GM2リズムチャンネル用）。有効時はnote_onの周波数を無視し
                 FIXED NOTE+FINEの固定ピッチで鳴らす（memory
                 `project_gm2_rhythm_channel_implementation.md`参照）。 -->
            <checkbox label="FIXED" handle="fixed_note_enable"/>
          </row>
        </stack>
        <stack gap="spacing">
          <row justify="start" gap="spacing">
            <knob label="ALG" handle="algorithm"/>
            <knob label="FB" handle="feedback"/>
            <knob label="FB.VEL" handle="feedback_velocity_sens"/>
          </row>
          <row justify="start" gap="spacing">
            <knob label="FIXED NOTE" handle="fixed_note"/>
            <knob label="FINE" handle="fixed_note_fine" bipolar="true"/>
          </row>
        </stack>
      </row>
    </panel>
  </panels>

  <panels>
    <panel repeat="operators" as="op" index="i" columns="2">
      <header>
        <title>OP {index+1}</title>
        <readout compute="mul-fine-ratio" args="mul,op_fine_tune" format="×{value:.2}"
          tooltip="Effective frequency ratio of MUL×FINE (excludes DT1)"/>
      </header>
      <row justify="start" gap="spacing">
        <stack gap="spacing" center="false">
          <time-eg-editor handle="eg" mapping="DbLinear" tl="tl"/>
        </stack>
        <stack gap="spacing" center="true">
          <knob label="TL" handle="tl"/>
          <!-- DT1も同じく中央128＝デチューンなしのバイポーラ（dt1_to_cents参照）。 -->
          <knob label="DT1" handle="dt1" bipolar="true"/>
          <knob label="V.GAIN" handle="velocity_gain" alt-label="VEL" alt-handle="vel_sens" enabled-if="is_carrier"/>
        </stack>
        <stack gap="spacing" center="true">
          <knob label="MUL" handle="mul"/>
          <!-- FINEも同じく中央128＝デチューンなしのバイポーラ（op_fine_tune_to_cents参照）。 -->
          <knob label="FINE" handle="op_fine_tune" bipolar="true"/>
          <knob label="LEVEL SCALE" handle="level_scale"/>
        </stack>
        <stack gap="spacing" center="true">
          <knob label="EGSFT" handle="eg_shift"/>
          <knob label="KSR" handle="ksr"/>
          <waveform handle="waveform" index="i"/>
          <checkbox label="AM" handle="ame"/>
        </stack>
      </row>
    </panel>
  </panels>
</layout>
