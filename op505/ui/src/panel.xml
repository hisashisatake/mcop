<layout fn="draw_op505_panel" params-type="Op505PanelParams" scroll-id="op505_panel">

  <style>
    <!-- 横並び<panels>グループ内、パネル間の隙間。 -->
    <panels gap="8"/>
    <!-- パネル枠の内側/外側余白（全パネル共通、egui::Marginがi8ベースのため整数のみ）。 -->
    <panel inner-margin="6" outer-margin="3"/>
    <!-- 全ウィジェット共通の既定マージン。 -->
    <widget margin="5 0 0 0"/>
    <algorithm-diagram width="130" height="100"/>
    <!-- TimeEg固定枠（Step 2）。GRAPH/KNOBSタブ切替・段数1〜8変更でこのサイズ自体は変わらない。
         高さ245＝ヘッダ20+コンテンツ190+spin行35。コンテンツ190はKNOBSモードの1段カラム
         （ラベル+knob(66px)×2+checkbox、item_spacing込みで実測約175px）が収まる下限
         （Step6実機確認で175だと段カラムがはみ出しパネル高さが跳ねる不具合を発見し追い込んだ値）。 -->
    <time-eg-editor width="260" height="245"/>
  </style>

  <panels match-height="true">
    <panel span="4" title="CHANNEL">
      <header>
        <jack kind="dest" dest-index="2" label="TX LFO" handle="texture_lfo_destination"/>
        <title/>
      </header>
      <row justify="between" gap="spacing">
        <algorithm-diagram handle="algorithm"/>
        <row grow="true" justify="between">
          <knob label="ALG" handle="algorithm" margin="0 60"/>
          <knob label="FB" handle="feedback" margin="0 30"/>
        </row>
      </row>
    </panel>
    <panel span="8" title="CHIP LFO">
      <header>
        <title/>
      </header>
      <row justify="between">
        <knob label="CH.FRQ" handle="chip_lfo_freq"/>
        <knob label="CH.PMD" handle="chip_lfo_pmd"/>
        <knob label="CH.AMD" handle="chip_lfo_amd"/>
        <knob label="CH.DLY" handle="chip_lfo_delay"/>
        <knob label="PMS" handle="pms"/>
        <knob label="AMS" handle="ams"/>
      </row>
    </panel>
  </panels>

  <panels>
    <panel span="7" title="TEXTURE LFO">
      <header>
        <jack kind="source"/>
        <title/>
      </header>
      <row justify="between">
        <stack>
          <enum label="TX.WAVE" handle="texture_lfo_waveform" names="LFO_WAVEFORM_NAMES" salt="2" margin="0 0 -10 0"/>
          <enum label="TX.FADE" handle="texture_lfo_fade_mode" names="LFO_FADE_MODE_NAMES" salt="3" margin="-10 0 -20 0"/>
        </stack>
        <knob label="TX.RATE" handle="texture_lfo_rate"/>
        <knob label="TX.DEP" handle="texture_lfo_depth"/>
        <knob label="TX.DLY" handle="texture_lfo_delay"/>
        <knob label="TX.F.TM" handle="texture_lfo_fade_time"/>
        <knob label="TX.OFS" handle="texture_lfo_offset"/>
      </row>
    </panel>
    <panel span="5" title="FILTER">
      <header>
        <title/>
      </header>
      <row justify="between">
        <knob label="CUTOFF" handle="cutoff"/>
        <knob label="RESO" handle="resonance"/>
        <knob label="TYPE" handle="filter_type"/>
        <checkbox label="SELF-OSC" handle="filter_self_oscillation"/>
      </row>
    </panel>
  </panels>

  <panels>
    <panel title="PITCH FG" span="4">
      <header>
        <jack kind="dest" dest-index="0" label="TX LFO" handle="texture_lfo_destination"/>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <!-- 最終段level=0固定を免除しSTAGE=1も許す（terminal-level="free"）。OP EGと違いボイス
             解放条件に関与しないため、リリース後にオフセットを残せる／段数を8まで使える。 -->
        <time-eg-editor handle="params.pitch_fg.eg" mapping="RawLinear" tl-value="255" min-stages="1" terminal-level="free"/>
        <knob label="P.DEP±" handle="params.pitch_fg.depth"/>
      </row>
      <row justify="start" gap="spacing">
        <checkbox label="SYNC" handle="params.pitch_fg.eg.sync_enabled_handle()"/>
        <enum label="NOTE" handle="params.pitch_fg.eg.sync_note_handle()" names="SYNC_NOTE_NAMES" salt="6"/>
        <enum label="RETRIG" handle="params.pitch_fg.eg.retrigger_mode_handle()" names="RETRIGGER_MODE_NAMES" salt="7"/>
      </row>
    </panel>
    <panel title="CUTOFF FG" span="4">
      <header>
        <jack kind="dest" dest-index="3" label="TX LFO" handle="texture_lfo_destination"/>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <time-eg-editor handle="params.cutoff_fg.eg" mapping="RawLinear" tl-value="255" min-stages="1" terminal-level="free"/>
        <knob label="F.DEP±" handle="params.cutoff_fg.depth"/>
      </row>
      <row justify="start" gap="spacing">
        <checkbox label="SYNC" handle="params.cutoff_fg.eg.sync_enabled_handle()"/>
        <enum label="NOTE" handle="params.cutoff_fg.eg.sync_note_handle()" names="SYNC_NOTE_NAMES" salt="8"/>
        <enum label="RETRIG" handle="params.cutoff_fg.eg.retrigger_mode_handle()" names="RETRIGGER_MODE_NAMES" salt="9"/>
      </row>
    </panel>
    <panel title="GAIN FG" span="4">
      <header>
        <jack kind="dest" dest-index="1" label="TX LFO" handle="texture_lfo_destination"/>
        <title/>
      </header>
      <row justify="start" gap="spacing">
        <!-- Gain FGだけ最終段level=0固定を免除し、STAGE=1も許す。出力への乗算でボイス解放には
             関与しないため0へ向かう必要がなく、level 0が「無音」を意味してしまうため
             （1段=透過既定＝ゲートを一切閉じない、op505-coreのdefault_gain_fg参照）。 -->
        <time-eg-editor handle="gain_fg" mapping="AmplitudeLinear" tl-value="255" min-stages="1" terminal-level="free"/>
      </row>
      <row justify="start" gap="spacing">
        <checkbox label="SYNC" handle="params.gain_fg.sync_enabled_handle()"/>
        <enum label="NOTE" handle="params.gain_fg.sync_note_handle()" names="SYNC_NOTE_NAMES" salt="10"/>
        <enum label="RETRIG" handle="params.gain_fg.retrigger_mode_handle()" names="RETRIGGER_MODE_NAMES" salt="11"/>
      </row>
    </panel>
  </panels>

  <panels>
    <panel repeat="operators" as="op" index="i" columns="2">
      <header>
        <title>OP {index+1}</title>
        <readout compute="mul-fine-ratio" args="mul,op_fine_tune" format="×{value:.2}"
          tooltip="MUL×FINEの実効周波数比（DT1は含まない）"/>
      </header>
      <row justify="start" gap="spacing">
        <time-eg-editor handle="eg" mapping="DbLinear" tl="tl"/>
        <stack grow="true" gap="spacing">
          <row justify="between">
            <knob label="TL" handle="tl"/>
            <knob label="MUL" handle="mul"/>
            <knob label="DT1" handle="dt1"/>
            <knob label="KSR" handle="ksr"/>
          </row>
          <row justify="between">
            <knob label="VEL" handle="vel_sens" enabled-if="!is_carrier"/>
            <knob label="V.GAIN" handle="velocity_gain" enabled-if="is_carrier"/>
            <knob label="FINE" handle="op_fine_tune"/>
            <knob label="EGSFT" handle="eg_shift"/>
          </row>
          <row justify="between">
            <knob label="LEVEL SCALE" handle="level_scale"/>
            <stack>
              <waveform handle="waveform" index="i"/>
              <checkbox label="AM" handle="ame"/>
            </stack>
          </row>
        </stack>
      </row>
    </panel>
  </panels>

  <panels>
    <panel span="5" title="MASTER EFFECT (REVERB)">
      <header>
        <title/>
      </header>
      <row justify="between">
        <enum label="REV TYPE" handle="reverb_type" names="REVERB_TYPE_NAMES" salt="4"/>
        <knob label="REV" handle="rev_send"/>
        <knob label="R.TIME" handle="reverb_time"/>
      </row>
    </panel>
    <panel span="7" title="MASTER EFFECT (CHORUS)">
      <header>
        <title/>
      </header>
      <row justify="between">
        <enum label="CHO TYPE" handle="chorus_type" names="CHORUS_TYPE_NAMES" salt="5"/>
        <knob label="CHO" handle="cho_send"/>
        <knob label="C.RATE" handle="chorus_mod_rate"/>
        <knob label="C.DEP" handle="chorus_mod_depth"/>
        <knob label="C.FB" handle="chorus_feedback"/>
        <knob label="C&gt;R" handle="chorus_send_to_reverb"/>
      </row>
    </panel>
  </panels>
</layout>
