{
  "productName": "gesture-app",
  "version": "0.1.0",
  "identifier": "com.op505.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-editor-wasm.ps1",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-editor-wasm.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OP505 作曲支援",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
